{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"q2-evidence-v5.schema.json",
  "title":"Q2 v5 retained evidence row",
  "type":"object",
  "additionalProperties":false,
  "required":["evidence_id","trial_id","condition","lifecycle","readiness","recovery","metrics","environment","topology","pre_state_digests","post_state_digests","cleanup_digests","qdisc_observations","failure_retained","raw_identifiers_prohibited"],
  "properties":{
    "evidence_id":{"$ref":"#/$defs/id"},"trial_id":{"$ref":"#/$defs/id"},"condition":{"enum":["no-flap","flap-A","flap-B"]},
    "lifecycle":{"$ref":"#/$defs/lifecycle"},"readiness":{"$ref":"#/$defs/readiness"},"recovery":{"$ref":"#/$defs/recovery"},"metrics":{"$ref":"#/$defs/metrics"},"environment":{"$ref":"#/$defs/environment"},"topology":{"$ref":"#/$defs/topology"},
    "pre_state_digests":{"$ref":"#/$defs/ordinalDigests"},"post_state_digests":{"$ref":"#/$defs/ordinalDigests"},"cleanup_digests":{"$ref":"#/$defs/ordinalDigests"},"qdisc_observations":{"$ref":"#/$defs/qdiscObservations"},"failure_retained":{"const":true},"raw_identifiers_prohibited":{"const":true}
  },
  "allOf":[
    {"if":{"properties":{"condition":{"const":"no-flap"}}},"then":{"properties":{"recovery":{"properties":{"eligible":{"const":false},"censored":{"const":false},"event_relative_ns":{"const":null}}},"qdisc_observations":{"maxItems":0}}}}
  ],
  "$defs":{
    "id":{"type":"string","pattern":"^[a-f0-9]{64}$"},"digest":{"type":"string","pattern":"^[a-f0-9]{64}$"},"retainedDigest":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},
    "ordinalDigest":{"type":"object","additionalProperties":false,"required":["ordinal","digest"],"properties":{"ordinal":{"type":"integer","minimum":0,"maximum":7},"digest":{"$ref":"#/$defs/retainedDigest"}}},
    "ordinalDigests":{"type":"array","minItems":8,"maxItems":8,"prefixItems":[{"allOf":[{"$ref":"#/$defs/ordinalDigest"},{"properties":{"ordinal":{"const":0}}}]},{"allOf":[{"$ref":"#/$defs/ordinalDigest"},{"properties":{"ordinal":{"const":1}}}]},{"allOf":[{"$ref":"#/$defs/ordinalDigest"},{"properties":{"ordinal":{"const":2}}}]},{"allOf":[{"$ref":"#/$defs/ordinalDigest"},{"properties":{"ordinal":{"const":3}}}]},{"allOf":[{"$ref":"#/$defs/ordinalDigest"},{"properties":{"ordinal":{"const":4}}}]},{"allOf":[{"$ref":"#/$defs/ordinalDigest"},{"properties":{"ordinal":{"const":5}}}]},{"allOf":[{"$ref":"#/$defs/ordinalDigest"},{"properties":{"ordinal":{"const":6}}}]},{"allOf":[{"$ref":"#/$defs/ordinalDigest"},{"properties":{"ordinal":{"const":7}}}]}],"items":false},
    "pathDigest":{"type":"object","additionalProperties":false,"required":["path","digest"],"properties":{"path":{"enum":["A","B"]},"digest":{"$ref":"#/$defs/digest"}}},
    "pathDigests":{"type":"array","minItems":2,"maxItems":2,"prefixItems":[{"allOf":[{"$ref":"#/$defs/pathDigest"},{"properties":{"path":{"const":"A"}}}]},{"allOf":[{"$ref":"#/$defs/pathDigest"},{"properties":{"path":{"const":"B"}}}]}],"items":false},
    "roleDigest":{"type":"object","additionalProperties":false,"required":["role","digest"],"properties":{"role":{"enum":["source-slot-0","destination-slot-0","source-slot-1","destination-slot-1"]},"digest":{"$ref":"#/$defs/digest"}}},
    "roleDigests":{"type":"array","minItems":4,"maxItems":4,"prefixItems":[{"allOf":[{"$ref":"#/$defs/roleDigest"},{"properties":{"role":{"const":"source-slot-0"}}}]},{"allOf":[{"$ref":"#/$defs/roleDigest"},{"properties":{"role":{"const":"destination-slot-0"}}}]},{"allOf":[{"$ref":"#/$defs/roleDigest"},{"properties":{"role":{"const":"source-slot-1"}}}]},{"allOf":[{"$ref":"#/$defs/roleDigest"},{"properties":{"role":{"const":"destination-slot-1"}}}]}],"items":false},
    "environment":{"type":"object","additionalProperties":false,"required":["environment_id","namespace_count","isolated_namespace_count","clock","kernel_digest","cpu_digest","release_binary_digest","source_digest","offload_digests","raw_identifiers_prohibited"],"properties":{"environment_id":{"$ref":"#/$defs/id"},"namespace_count":{"const":4},"isolated_namespace_count":{"const":4},"clock":{"const":"CLOCK_MONOTONIC_RAW"},"kernel_digest":{"$ref":"#/$defs/digest"},"cpu_digest":{"$ref":"#/$defs/digest"},"release_binary_digest":{"$ref":"#/$defs/digest"},"source_digest":{"$ref":"#/$defs/digest"},"offload_digests":{"$ref":"#/$defs/ordinalDigests"},"raw_identifiers_prohibited":{"const":true}}},
    "topology":{"type":"object","additionalProperties":false,"required":["topology_id","seed","interface_count","veth_pair_count","path_count","manifest_digest","route_digests","source_policy_digests","hop_digests","interface_digests","locator_digests","mac_digests","raw_identifiers_prohibited"],"properties":{"topology_id":{"$ref":"#/$defs/id"},"seed":{"type":"integer","minimum":0,"maximum":219},"interface_count":{"const":8},"veth_pair_count":{"const":4},"path_count":{"const":2},"manifest_digest":{"$ref":"#/$defs/digest"},"route_digests":{"$ref":"#/$defs/pathDigests"},"source_policy_digests":{"$ref":"#/$defs/pathDigests"},"hop_digests":{"$ref":"#/$defs/pathDigests"},"interface_digests":{"$ref":"#/$defs/ordinalDigests"},"locator_digests":{"$ref":"#/$defs/roleDigests"},"mac_digests":{"$ref":"#/$defs/ordinalDigests"},"raw_identifiers_prohibited":{"const":true}}},
    "lifecycle":{"type":"object","additionalProperties":false,"required":["status","failure_reason","setup_status","cleanup_status","failure_retained"],"properties":{"status":{"enum":["completed","failed","timeout"]},"failure_reason":{"enum":["readiness_not_reached","flap-timing","fault_not_applied","trial_timeout","supervisor_timeout","binding_mismatch","evidence_missing","cleanup_failed",null]},"setup_status":{"enum":["passed","failed","not_completed"]},"cleanup_status":{"enum":["passed","failed","not_completed"]},"failure_retained":{"const":true}},"allOf":[{"if":{"properties":{"status":{"const":"completed"}}},"then":{"properties":{"failure_reason":{"const":null},"setup_status":{"const":"passed"},"cleanup_status":{"const":"passed"}}}},{"if":{"properties":{"status":{"const":"timeout"}}},"then":{"properties":{"failure_reason":{"enum":["trial_timeout","supervisor_timeout"]}}}},{"if":{"properties":{"cleanup_status":{"const":"failed"}}},"then":{"properties":{"failure_reason":{"const":"cleanup_failed"},"status":{"const":"failed"}}}}]},
    "readiness":{"type":"object","additionalProperties":false,"required":["relative_ns","consecutive_authenticated_on_schedule_deliveries"],"properties":{"relative_ns":{"type":["integer","null"],"minimum":-100000000,"maximum":0},"consecutive_authenticated_on_schedule_deliveries":{"type":"integer","minimum":0,"maximum":10}}},
    "recovery":{"type":"object","additionalProperties":false,"required":["eligible","censored","event_relative_ns","observed_followup_ns"],"properties":{"eligible":{"type":"boolean"},"censored":{"type":"boolean"},"event_relative_ns":{"type":["integer","null"],"minimum":0,"maximum":2000000000},"observed_followup_ns":{"type":"integer","minimum":0,"maximum":2000000000}},"allOf":[{"if":{"properties":{"eligible":{"const":false}}},"then":{"properties":{"event_relative_ns":{"const":null}}}},{"if":{"properties":{"censored":{"const":true}}},"then":{"properties":{"event_relative_ns":{"const":null}}}},{"if":{"properties":{"event_relative_ns":{"type":"integer"}}},"then":{"properties":{"eligible":{"const":true},"censored":{"const":false}}}}]},
    "metrics":{"type":"object","additionalProperties":false,"required":["sent_packets","delivered_packets","lost_packets","duplicates","reorder_displacement_count","max_consecutive_loss_burst","degraded_interval_ns","wire_bytes","wire_packets","cpu_user_ns","cpu_system_ns","queue_high_water_packets","queue_overflow_packets"],"properties":{"sent_packets":{"type":"integer","minimum":0,"maximum":400},"delivered_packets":{"type":"integer","minimum":0,"maximum":400},"lost_packets":{"type":"integer","minimum":0,"maximum":400},"duplicates":{"type":"integer","minimum":0},"reorder_displacement_count":{"type":"integer","minimum":0},"max_consecutive_loss_burst":{"type":"integer","minimum":0,"maximum":400},"degraded_interval_ns":{"type":["integer","null"],"minimum":0},"wire_bytes":{"type":["integer","null"],"minimum":0},"wire_packets":{"type":["integer","null"],"minimum":0},"cpu_user_ns":{"type":["integer","null"],"minimum":0},"cpu_system_ns":{"type":["integer","null"],"minimum":0},"queue_high_water_packets":{"type":["integer","null"],"minimum":0},"queue_overflow_packets":{"type":["integer","null"],"minimum":0}}},
    "qdiscObservation":{"type":"object","additionalProperties":false,"required":["ordinal","start_actual_relative_ns","end_actual_relative_ns"],"properties":{"ordinal":{"enum":[0,3,4,7]},"start_actual_relative_ns":{"type":["integer","null"]},"end_actual_relative_ns":{"type":["integer","null"]}}},
    "qdiscObservations":{"type":"array","items":{"$ref":"#/$defs/qdiscObservation"},"maxItems":2}
  }
}
